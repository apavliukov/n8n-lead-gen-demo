# Pinned image version. Check the running one with: docker exec n8n n8n --version
N8N_VERSION=2.48.7

# URL where n8n is reachable from outside (behind the reverse proxy), with a trailing slash
N8N_PUBLIC_URL=https://n8n.example.com/

# Credentials encryption key. Generate with: openssl rand -hex 32
# When migrating an existing install, reuse the key from /home/node/.n8n/config
N8N_ENCRYPTION_KEY=

POSTGRES_PASSWORD=

# Timezone of n8n itself: schedule triggers and $now. The database stores timestamptz regardless.
TZ=UTC

# Set to "dev" to start the Mailpit mail catcher (SMTP mailpit:1025, UI on 127.0.0.1:8025)
COMPOSE_PROFILES=

# Local only (not used on the server): n8n API access for scripts/export.sh
N8N_URL=https://n8n.example.com
N8N_API_KEY=
