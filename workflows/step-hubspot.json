    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH saved AS (\n    INSERT INTO leadgen.provider_records (order_id, provider_id, type, external_id, response)\n    VALUES ($1, $2, 'hubspot_contact', $3, NULL),\n           ($1, $2, 'hubspot_deal', $4, $5::jsonb)\n    ON CONFLICT (order_id, type) DO NOTHING\n)\nUPDATE leadgen.orders\nSET duplicate = $6\nWHERE id = $1",
        "options": {
          "queryReplacement": "={{ [ $('Start').first().json.order.id, $('Start').first().json.order.providers.hubspot.id, $json.associations?.contacts?.results?.[0]?.id ?? $('Start').first().json.check.contact_id ?? $('Create contact').first().json.id, $('Start').first().json.check.own_deal_id ?? $json.id, JSON.stringify($json), $('Start').first().json.check.duplicate ] }}"
        }
      },
