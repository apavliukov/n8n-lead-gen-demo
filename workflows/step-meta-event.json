    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Purchase event for the Meta Conversions API. Personal data is normalized the way Meta\n-- prescribes and then hashed; IP, user agent and the click cookies are sent as they are.\nSELECT jsonb_strip_nulls(jsonb_build_object(\n    'event_name', 'Purchase',\n    'event_time', extract(epoch FROM o.created_at)::bigint,\n    'event_id', o.id::text,                -- lets Meta deduplicate against the browser pixel\n    'action_source', 'website',\n    'event_source_url', nullif(o.payload->>'original_url', ''),\n    'user_data', jsonb_build_object(\n        'em', leadgen.meta_hash(o.email),\n        'ph', leadgen.meta_hash(regexp_replace(o.phone, '\\D', '', 'g')),              -- digits with country code\n        'fn', leadgen.meta_hash(lower(trim(o.payload->>'first_name'))),\n        'ln', leadgen.meta_hash(lower(trim(o.payload->>'last_name'))),\n        'db', leadgen.meta_hash(replace(o.payload->>'birth_date', '-', '')),          -- YYYYMMDD\n        'ct', leadgen.meta_hash(lower(regexp_replace(o.payload->>'city', '[\\s[:punct:]]', '', 'g'))),\n        'zp', leadgen.meta_hash(lower(regexp_replace(o.payload->>'postal_code', '\\s', '', 'g'))),\n        'client_ip_address', o.meta->>'ip',\n        'client_user_agent', o.meta->>'user_agent',\n        'fbc', nullif(o.payload->>'fbc', ''),\n        'fbp', nullif(o.payload->>'fbp', '')\n    ),\n    'custom_data', jsonb_build_object(\n        'currency', 'EUR',\n        'value', p.price,\n        'order_id', o.id::text\n    )\n)) AS event\nFROM leadgen.orders o\nJOIN leadgen.products p ON p.id = o.product_id\nWHERE o.id = $1",
        "options": {
          "queryReplacement": "={{ [ $('Start').first().json.order.id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        480,
        -16
      ],
      "id": "e8bb28c1-1f41-4c9c-b64c-2a1d0c0247b6",
