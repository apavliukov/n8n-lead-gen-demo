      "parameters": {
        "jsCode": "// Steps run independently: a failed one does not stop the others.\n// A failed sub-workflow call yields { error: \"<message>\" } instead of its result.\nconst steps = ['Order email', 'Meta event'];\nconst failed = steps\n  .filter((name) => $(name).first().json.error)\n  .map((name) => `${name}: ${$(name).first().json.error}`);\n\nreturn [{ json: { failed } }];"
