    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Claim the order for this run. No row back means it is terminal or another run holds it.\n-- The retry is scheduled right here, before any work: a failed or crashed run needs no cleanup,\n-- the order simply comes due again. After the last retry next_attempt_at becomes NULL.\nUPDATE leadgen.orders o\nSET locked_at = now(),\n    attempts = o.attempts + 1,\n    next_attempt_at = now() + (ARRAY['15 minutes', '1 hour', '3 hours', '12 hours', '24 hours']::interval[])[o.attempts + 1]\nFROM leadgen.products p, leadgen.sites s\nWHERE o.id = $1\n  AND p.id = o.product_id\n  AND s.id = o.site_id\n  AND NOT o.blocked\n  AND o.duplicate <> 2                                                     -- 2 = bad duplicate\n  AND o.completed_at IS NULL\n  AND (o.locked_at IS NULL OR o.locked_at < now() - interval '10 minutes') -- a stale claim is a crashed run\nRETURNING o.id, o.email, o.phone, o.payload, o.meta, o.attempts, o.created_at,\n          p.name AS product_name, p.price,\n          p.hubspot_pipeline, p.hubspot_stage, p.hubspot_duplicate_stage,\n          s.duplicate_days,\n          s.name AS site_name, s.email_from, s.email_from_name,\n          (SELECT code FROM leadgen.sources WHERE id = o.source_id) AS source,\n          -- Providers connected to the site, keyed by type: {\"hubspot\": {\"id\": 1, \"settings\": {}}}\n          (SELECT coalesce(jsonb_object_agg(pr.type, jsonb_build_object('id', pr.id, 'settings', sp.settings)), '{}')\n           FROM leadgen.site_providers sp\n           JOIN leadgen.providers pr ON pr.id = sp.provider_id\n           WHERE sp.site_id = o.site_id AND sp.active AND pr.active) AS providers,\n          -- Steps that already succeeded for this order: [\"hubspot_contact\", \"hubspot_deal\"]\n          (SELECT coalesce(jsonb_agg(r.type), '[]')\n           FROM leadgen.provider_records r\n           WHERE r.order_id = o.id) AS done",
        "options": {
          "queryReplacement": "={{ [ $json.order_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
