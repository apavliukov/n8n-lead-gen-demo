    {
      "parameters": {
        "jsCode": "// Maps the order to HubSpot contact and deal properties.\nconst order = $('Claim order').first().json;\nconst check = $('Check duplicate').first().json;\nconst form = order.payload;\n\n// DD.MM.YYYY -> YYYY-MM-DD, the format HubSpot date properties accept.\nconst isoDate = (value) => (value ? value.split('.').reverse().join('-') : undefined);\n// Host of the landing page the form was submitted from. The URL class is not available here.\nconst domain = (url) => String(url ?? '').match(/^https?:\\/\\/([^\\/?#]+)/)?.[1];\n\nreturn [{\n  json: {\n    contact_id: check.contact_id,\n    contact: {\n      firstname: form.first_name,\n      lastname: form.last_name,\n      phone: order.phone,\n      address: `${form.street} ${form.house_number}`,\n      zip: form.postal_code,\n      city: form.city,\n      date_of_birth: form.birth_date,\n      birth_place: form.birth_place,\n      id_number: form.id_number,\n      id_valid_until: isoDate(form.id_valid_until),\n      iban: form.iban,\n    },\n    deal: {\n      dealname: `${form.first_name} ${form.last_name}`,\n      amount: order.price,\n      pipeline: order.hubspot_pipeline,\n      dealstage: check.is_good_duplicate ? order.hubspot_duplicate_stage : order.hubspot_stage,\n      description: `Previous deal: ${check.last_deal_id ?? 'none'}`,\n      order_number: String(order.id),\n      order_email: order.email,\n      product_name: order.product_name,\n      source_domain: domain(form.original_url),\n      client_ip: order.meta.ip,\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -32
      ],
      "id": "8d957181-4656-4aaf-ae51-c9408df2ec10",
      "name": "HubSpot data"
    },
