    {
      "parameters": {
        "jsCode": "// Maps the order to HubSpot contact and deal properties.\n// The contact holds identity only and is never updated; everything a customer can change\n// between orders (address, bank account, id document, contact details) is a snapshot on the deal.\nconst order = $('Claim order').first().json;\nconst check = $('Check duplicate').first().json;\nconst form = order.payload;\n\n// DD.MM.YYYY -> YYYY-MM-DD, the format HubSpot date properties accept.\nconst isoDate = (value) => (value ? value.split('.').reverse().join('-') : undefined);\n// Host of the landing page the form was submitted from. The URL class is not available here.\nconst domain = (url) => String(url ?? '').match(/^https?:\\/\\/([^\\/?#]+)/)?.[1];\n\nreturn [{\n  json: {\n    contact_id: check.contact_id,\n    contact: {\n      firstname: form.first_name,\n      lastname: form.last_name,\n      phone: order.phone,\n      date_of_birth: form.birth_date,\n      birth_place: form.birth_place,\n    },\n    deal: {\n      dealname: `${form.first_name} ${form.last_name}`,\n      amount: order.price,\n      pipeline: order.hubspot_pipeline,\n      dealstage: check.is_good_duplicate ? order.hubspot_duplicate_stage : order.hubspot_stage,\n      description: `Previous deal: ${check.last_deal_id ?? 'none'}`,\n      order_number: String(order.id),\n      product_name: order.product_name,\n      source_domain: domain(form.original_url),\n      client_ip: order.meta.ip,\n      order_email: order.email,\n      order_phone: order.phone,\n      address: `${form.street} ${form.house_number}`,\n      postal_code: form.postal_code,\n      city: form.city,\n      iban: form.iban,\n      id_number: form.id_number,\n      id_valid_until: isoDate(form.id_valid_until),\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1712,
        -32
      ],
      "id": "8d957181-4656-4aaf-ae51-c9408df2ec10",
      "name": "HubSpot data"
    },
