    {
      "parameters": {
        "jsCode": "const DUPLICATE = { NONE: 0, GOOD: 1, BAD: 2 };  // 0 no, 1 good (previous deal older than the threshold), 2 bad (recent deal)\nconst input = $('When Executed by Another Workflow').first().json;\nconst contacts = $('Find contact').first().json.results ?? [];\n// The deal search is skipped when no contact was found.\nconst deal = $('Find latest deal').isExecuted\n  ? ($('Find latest deal').first().json.results ?? [])[0] ?? null\n  : null;\n\nlet duplicate = DUPLICATE.NONE;\nif (deal) {\n  const ageDays = (Date.now() - new Date(deal.properties.createdate).getTime()) / 86400000;\n  duplicate = ageDays < input.duplicate_days ? DUPLICATE.BAD : DUPLICATE.GOOD;\n}\n\n// Prefer the contact that owns the order email; a phone-only match is a weaker identity.\nconst byEmail = contacts.find((c) => c.properties.email?.toLowerCase() === input.email);\nconst contact = byEmail ?? contacts[0] ?? null;\n\nreturn [{\n  json: {\n    contact_id: contact?.id ?? null,\n    duplicate,\n    is_bad_duplicate: duplicate === DUPLICATE.BAD,\n    is_good_duplicate: duplicate === DUPLICATE.GOOD,\n    last_deal_id: deal?.id ?? null,\n    last_deal_at: deal?.properties.createdate ?? null,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
