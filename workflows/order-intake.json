    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.id AS site_id, s.duplicate_days,\n       s.name AS site_name, s.email_from, s.email_from_name, s.email_reply_to,\n       p.id AS product_id, p.name AS product_name, p.price, p.required_fields\nFROM leadgen.sites s\nLEFT JOIN leadgen.products p ON p.site_id = s.id AND p.external_id = $2\nWHERE s.token::text = $1",
        "options": {
          "queryReplacement": "={{ [ $json.body.token ?? '', $json.body.product_id ?? '' ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        224,
        0
      ],
      "id": "a3184afc-f0aa-472d-94e9-b38aac88463a",
      "name": "Load site and product",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "LOPaUITik7f6aoEh",
          "name": "Leadgen DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const req = $('Webhook').first().json;\nconst body = req.body ?? {};\nconst row = $input.first().json; // site + product; empty when the token is unknown\n\nconst str = (v) => (typeof v === 'string' ? v.trim() : '');\nconst errors = {};\n\nif (!row.site_id) errors.token = 'unknown site';\nelse if (!row.product_id) errors.product_id = 'unknown product';\n\n// Honeypot: a real form never sends this field.\nif (str(body.terms)) errors.terms = 'must be empty';\n\nconst common = ['idempotency_key', 'first_name', 'last_name', 'email', 'phone',\n  'birth_date', 'street', 'house_number', 'postal_code', 'city', 'iban'];\nfor (const field of [...common, ...(row.required_fields ?? [])]) {\n  if (!str(body[field])) errors[field] = 'required';\n}\n\nconst email = str(body.email).toLowerCase();\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.email = 'invalid';\n\n// 0151..., 0049151..., 49151..., +490151... -> +49151...\nconst digits = str(body.phone).replace(/[^\\d+]/g, '').replace(/^(\\+49|0049|49|0)0*/, '');\nconst phone = '+49' + digits;\nif (str(body.phone) && !/^\\+49\\d{6,13}$/.test(phone)) errors.phone = 'invalid';\n\n// Format check only; the checksum is validated on the landing page.\nconst iban = str(body.iban).replace(/\\s/g, '').toUpperCase();\nif (iban && !/^[A-Z]{2}\\d{2}[A-Z0-9]{11,30}$/.test(iban)) errors.iban = 'invalid';\n\n// DD.MM.YYYY -> YYYY-MM-DD, rejecting impossible dates like 31.02.\nlet birthDate = null;\nlet age = null;\nconst m = str(body.birth_date).match(/^(\\d{2})\\.(\\d{2})\\.(\\d{4})$/);\nif (m) {\n  const iso = `${m[3]}-${m[2]}-${m[1]}`;\n  const d = new Date(`${iso}T00:00:00Z`);\n  if (!isNaN(d) && d.toISOString().slice(0, 10) === iso) {\n    birthDate = iso;\n    const now = new Date();\n    age = now.getUTCFullYear() - d.getUTCFullYear();\n    const hadBirthday = now.getUTCMonth() > d.getUTCMonth()\n      || (now.getUTCMonth() === d.getUTCMonth() && now.getUTCDate() >= d.getUTCDate());\n    if (!hadBirthday) age -= 1;\n  }\n}\nif (str(body.birth_date) && (birthDate === null || age < 0)) errors.birth_date = 'invalid';\n\n// Parsed by hand to stay independent of sandbox globals such as URL.\nconst queryParam = (name) => {\n  const found = str(body.original_url).match(new RegExp(`[?&]${name}=([^&#]*)`));\n  if (!found) return null;\n  try { return decodeURIComponent(found[1].replace(/\\+/g, ' ')); } catch (e) { return found[1]; }\n};\nconst utm = {};\nfor (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content']) {\n  utm[key] = str(body[key]) || queryParam(key) || null;\n}\n// Paid traffic leaves a click id in the URL or the Meta click cookie.\nconst source = queryParam('fbclid') || str(body.fbc) ? 'facebook' : 'direct';\n\n// Service fields are stored in meta, not in the form payload.\nconst { token, terms, idempotency_key, client_ip, user_agent, ...form } = body;\n\nreturn [{\n  json: {\n    valid: Object.keys(errors).length === 0,\n    errors,\n    order: {\n      site_id: row.site_id ?? null,\n      product_id: row.product_id ?? null,\n      idempotency_key: str(idempotency_key),\n      email,\n      phone,\n      source,\n      blocked: age !== null && age < 18,\n      payload: { ...form, email, phone, iban, birth_date: birthDate },\n      meta: {\n        ip: str(client_ip) || req.headers['x-real-ip']\n          || str(req.headers['x-forwarded-for']).split(',')[0].trim() || null,\n        user_agent: str(user_agent) || req.headers['user-agent'] || null,\n        ...utm,\n      },\n    },\n  },\n}];"
      },
