    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- A repeated request (same site + idempotency key) gets the existing order back.\n-- The lookup runs first so that a replay does not consume an order number.\nWITH existing AS (\n    SELECT id, blocked, duplicate\n    FROM leadgen.orders\n    WHERE site_id = $1 AND idempotency_key = $4\n), inserted AS (\n    INSERT INTO leadgen.orders\n        (site_id, product_id, source_id, idempotency_key, email, phone, payload, meta, blocked, next_attempt_at)\n    SELECT $1, $2, s.id, $4, $5, $6, $7::jsonb, $8::jsonb, $9::boolean,\n           CASE\n               WHEN $9::boolean THEN NULL                               -- blocked: never processed\n               WHEN v.email IS NOT NULL THEN now()                      -- verified address: process right away\n               ELSE now() + interval '2 hours'                          -- wait for the verification click\n           END\n    FROM leadgen.sources s\n    LEFT JOIN leadgen.verified_emails v ON v.email = $5\n    WHERE s.code = $3 AND NOT EXISTS (SELECT 1 FROM existing)\n    -- Two simultaneous requests both miss the lookup; the unique index settles it.\n    -- The no-op update makes RETURNING yield the winning row instead of nothing.\n    ON CONFLICT (site_id, idempotency_key) DO UPDATE SET idempotency_key = EXCLUDED.idempotency_key\n    RETURNING id, blocked, duplicate, (xmax = 0) AS created\n)\nSELECT r.id, r.blocked, r.duplicate, r.created,\n       EXISTS (SELECT 1 FROM leadgen.verified_emails WHERE email = $5) AS email_verified\nFROM (\n    SELECT id, blocked, duplicate, created FROM inserted\n    UNION ALL\n    SELECT id, blocked, duplicate, false FROM existing\n) r",
        "options": {
          "queryReplacement": "={{ [ $json.order.site_id, $json.order.product_id, $json.order.source, $json.order.idempotency_key, $json.order.email, $json.order.phone, JSON.stringify($json.order.payload), JSON.stringify($json.order.meta), $json.order.blocked ] }}"
        }
      },
