    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Orders due for processing: the oldest one per customer, and only while that customer has\n-- no order in progress or just finished. The next order follows on a later run, once the\n-- new deal is visible to the HubSpot search and can be recognized as a duplicate.\nSELECT DISTINCT ON (o.email) o.id AS order_id\nFROM leadgen.orders o\nWHERE o.next_attempt_at <= now()\n  AND NOT o.blocked\n  AND o.duplicate <> 2                  -- 2 = bad duplicate\n  AND o.completed_at IS NULL\n  AND NOT EXISTS (\n      SELECT 1\n      FROM leadgen.orders x\n      WHERE x.email = o.email\n        AND (x.locked_at > now() - interval '10 minutes'       -- being processed, or crashed recently\n          OR x.completed_at > now() - interval '1 minute')     -- its deal may not be searchable yet\n  )\nORDER BY o.email, o.id\nLIMIT 20",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        256,
        0
      ],
      "id": "d25e39f5-e2d1-4cf9-bbcb-149270911e7e",
      "name": "Due orders",
      "credentials": {
        "postgres": {
          "id": "LOPaUITik7f6aoEh",
          "name": "Leadgen DB"
        }
      }
