    {
      "parameters": {
        "content": "Queue rules (inside the query)\n- one order per customer per batch, oldest first\n- a customer is skipped while another order of theirs is in progress\n  or was completed less than 1 minute ago, so the next order can find\n  the new deal in HubSpot and be recognized as a duplicate\n- batches of 20 until the queue is empty",
        "height": 208,
        "width": 400
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        0,
        -288
      ],
      "typeVersion": 1,
      "id": "19e9e598-2aa5-4140-b81d-52aae053bb21",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Orders that ran out of attempts: nothing scheduled, not finished, and the last claim is stale.\n-- failed_at marks them as reported, so each order is announced once.\nUPDATE leadgen.orders o\nSET failed_at = now()\nFROM leadgen.sites s\nWHERE s.id = o.site_id\n  AND o.failed_at IS NULL\n  AND o.completed_at IS NULL\n  AND o.next_attempt_at IS NULL\n  AND NOT o.blocked\n  AND o.duplicate <> 2                                   -- 2 = bad duplicate\n  AND o.locked_at < now() - interval '10 minutes'\nRETURNING o.id AS order_id, o.email, o.attempts, s.name AS site_name",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
