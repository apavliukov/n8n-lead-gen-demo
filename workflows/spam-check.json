          "name": "Typesafe"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leadgen.provider_records (order_id, provider_id, type, response)\nVALUES ($1, $2, 'spam_check', $3::jsonb)\nON CONFLICT (order_id, type) DO UPDATE SET response = EXCLUDED.response",
        "options": {
          "queryReplacement": "={{ [ $('Start').first().json.order.id, $('Start').first().json.order.providers.typesafe.id, JSON.stringify($json.answers.verdict) ] }}"
        }
