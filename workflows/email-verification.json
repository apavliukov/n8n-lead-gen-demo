    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Mark the address verified and make its waiting orders due now. Always returns one row:\n-- email is NULL for an unknown token, order_ids lists the released orders, oldest first.\nWITH clicked AS (\n    SELECT o.email, s.email_verified_url\n    FROM leadgen.orders o\n    JOIN leadgen.sites s ON s.id = o.site_id\n    WHERE o.verification_token = $1::uuid\n), verified AS (\n    INSERT INTO leadgen.verified_emails (email)\n    SELECT email FROM clicked\n    ON CONFLICT (email) DO NOTHING\n), released AS (\n    UPDATE leadgen.orders o\n    SET next_attempt_at = now()\n    FROM clicked\n    WHERE o.email = clicked.email\n      AND NOT o.blocked\n      AND o.duplicate <> 2              -- 2 = bad duplicate\n      AND o.completed_at IS NULL\n      AND o.next_attempt_at > now()     -- still waiting for the click or the timeout\n      AND o.attempts = 0                -- not tried yet; a failed order keeps its retry schedule\n    RETURNING o.id\n)\nSELECT (SELECT email FROM clicked) AS email,\n       (SELECT email_verified_url FROM clicked) AS redirect_url,\n       (SELECT coalesce(array_agg(id ORDER BY id), '{}') FROM released) AS order_ids",
        "options": {
          "queryReplacement": "={{ [ $json.query.token ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        480,
